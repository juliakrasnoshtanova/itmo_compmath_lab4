%%{init: {"flowchart": {"nodeSpacing": 24, "rankSpacing": 30, "wrappingWidth": 460}, "themeVariables": {"fontSize": "17px"}}}%%
flowchart TD
    START(["Начало"])
    START --> TITLE["Степенная аппроксимация<br/>stepennaya(x, y),  stepennaya_f(x) = a · x<sup>b</sup>"]
    TITLE --> INPUT[/"Ввод: x, y"/]
    INPUT --> CHECK_DOMAIN{"vse_polozh(x) и vse_polozh(y)?"}
    CHECK_DOMAIN -- "Нет" --> ERR_DOMAIN[/"Вывод: None"/]
    ERR_DOMAIN --> END
    CHECK_DOMAIN -- "Да" --> INIT["Подготовка:<br/>n ← len(x)<br/>X ← [], Y ← []<br/>i ← 0"]
    INIT --> CHECK_I{"i < n?"}
    CHECK_I -- "Да" --> TRANS["Линеаризовать точку:<br/>X<sub>i</sub> ← ln x<sub>i</sub><br/>Y<sub>i</sub> ← ln y<sub>i</sub><br/>i ← i + 1"]
    TRANS --> CHECK_I
    CHECK_I -- "Нет" --> LIN["Линейное приближение X, Y:<br/>A, B ← linear(X, Y)"]
    LIN --> COEFFS["Обратная замена:<br/>a ← e<sup>B</sup><br/>b ← A"]
    COEFFS --> OUT_OK[/"Вывод: a, b"/]
    OUT_OK --> END
    END(["Конец"])
